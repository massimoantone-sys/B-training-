      const c = state.clients.find(x => x.id === session.clientId);
      if (!c) return;
      const item = c.workoutItems.find(w => w.uid === uid);
      if (!item) return;

      const wasDone = item.completedSets[setIndex];
      item.completedSets[setIndex] = !wasDone;

      // Déclenche automatiquement le chrono de repos quand on valide une série
      if (!wasDone) {
        const ex = state.exercises.find(e => e.id === item.exerciseId);
        startRestTimer(item.rest, `${ex?.name || "Exercice"} — Série ${setIndex + 1}/${item.sets}`);
      }

      saveState();
      render();
    };

    window.resetClientWorkout = function() {
      const c = state.clients.find(x => x.id === session.clientId);
      if (!c) return;
      c.workoutItems.forEach(item => {
        item.completedSets = Array(item.sets).fill(false);
