          </header>

          <main class="mx-auto max-w-2xl px-4 pt-5">
            ${clientTab === "workout" ? `
              <div class="rounded-2xl border border-slate-800 bg-[#0f172a] p-4 mb-5">
                <div class="flex items-center justify-between gap-2">
                  <div>
                    <span class="text-[11px] font-bold uppercase text-emerald-400">Programme actif</span>
                    <h2 class="text-lg font-extrabold text-white">${client.workoutName}</h2>
                  </div>
                  <button onclick="resetClientWorkout()" class="rounded-xl border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs font-semibold text-slate-300 hover:text-white">
                    Réinitialiser
                  </button>
                </div>
                <div class="mt-3">
                  <div class="flex justify-between text-xs text-slate-400 mb-1">
                    <span>Progression séance</span>
                    <span class="font-bold text-emerald-400">${doneSets}/${totalSets} séries (${progressPct}%)</span>
                  </div>
                  <div class="h-2 w-full overflow-hidden rounded-full bg-slate-800">
                    <div class="h-full bg-emerald-500 transition-all duration-300" style="width: ${progressPct}%"></div>
                  </div>
                </div>
              </div>

              <div class="space-y-4">
                ${client.workoutItems.map((item, idx) => {
                  const ex = state.exercises.find(e => e.id === item.exerciseId);
                  return `
                    <div class="rounded-2xl border border-slate-800 bg-[#0f172a] p-4">
                      <div class="flex items-start justify-between gap-3">
                        <div>
                          <span class="text-[11px] font-bold uppercase text-emerald-400">Exercice ${idx + 1} • ${ex?.muscle || ""}</span>
                          <h3 class="text-base font-bold text-white mt-0.5">${ex?.name || "Exercice"}</h3>
                          <p class="text-xs text-slate-400 mt-0.5">Machine : ${ex?.machine || "Standard"}</p>
                        </div>
                        <button onclick="openDemoModal('${item.exerciseId}')" class="shrink-0 rounded-xl border border-emerald-500/40 bg-emerald-500/15 px-3 py-2 text-xs font-bold text-emerald-300 hover:bg-emerald-500/25">
                          ▶ Démo vidéo
                        </button>
                      </div>

                      <div class="mt-3 flex flex-wrap gap-2 text-xs">
                        <span class="rounded-lg bg-slate-900 border border-slate-800 px-2.5 py-1 text-slate-300">Objectif : <strong>${item.reps} reps</strong></span>
                        <span class="rounded-lg bg-slate-900 border border-slate-800 px-2.5 py-1 text-slate-300">Charge : <strong>${item.load}</strong></span>
                        <span class="rounded-lg bg-slate-900 border border-slate-800 px-2.5 py-1 text-emerald-400">Repos auto : <strong>${item.rest}s</strong></span>
                      </div>

                      <div class="mt-4 space-y-2">
                        ${item.completedSets.map((done, sIdx) => `
                          <button onclick="toggleSetDone('${item.uid}', ${sIdx})"
                            class="w-full flex items-center justify-between rounded-xl border px-3.5 py-2.5 text-sm font-semibold transition ${done ? 'border-emerald-500/50 bg-emerald-500/15 text-emerald-300' : 'border-slate-800 bg-slate-950 text-slate-200 hover:border-slate-700'}">
                            <span>Série ${sIdx + 1} • ${item.reps} reps (${item.load})</span>
                            <span class="flex h-6 w-6 items-center justify-center rounded-lg text-xs font-black ${done ? 'bg-emerald-500 text-slate-950' : 'border border-slate-700 bg-slate-900 text-slate-500'}">
                              ${done ? '✓' : ''}
                            </span>
                          </button>
                        `).join("")}
                      </div>
                    </div>
                  `;
                }).join("")}
              </div>
            ` : clientTab === "nutrition" ? `
              <div class="space-y-4">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                  <div class="rounded-2xl border border-slate-800 bg-[#0f172a] p-4 text-center">
                    <p class="text-xs text-slate-400">Calories</p>
                    <p class="text-xl font-black text-white mt-1">${client.nutrition.calories}</p>
                    <p class="text-[11px] text-emerald-400">kcal / jour</p>
                  </div>
                  <div class="rounded-2xl border border-slate-800 bg-[#0f172a] p-4 text-center">
                    <p class="text-xs text-slate-400">Protéines</p>
                    <p class="text-xl font-black text-emerald-400 mt-1">${client.nutrition.protein}g</p>
                  </div>
                  <div class="rounded-2xl border border-slate-800 bg-[#0f172a] p-4 text-center">
                    <p class="text-xs text-slate-400">Glucides</p>
                    <p class="text-xl font-black text-sky-400 mt-1">${client.nutrition.carbs}g</p>
                  </div>
                  <div class="rounded-2xl border border-slate-800 bg-[#0f172a] p-4 text-center">
                    <p class="text-xs text-slate-400">Lipides</p>
                    <p class="text-xl font-black text-amber-400 mt-1">${client.nutrition.fats}g</p>
                  </div>
                </div>

                <div class="rounded-2xl border border-slate-800 bg-[#0f172a] p-5">
                  <h2 class="text-base font-bold text-white mb-3">Plan alimentaire du Coach</h2>
                  <div class="whitespace-pre-line rounded-xl border border-slate-800 bg-slate-950 p-4 text-sm leading-relaxed text-slate-300">${client.nutrition.meals}</div>
                </div>
              </div>
            ` : `
              <div class="space-y-4">
                <div class="grid grid-cols-2 gap-3">
                  <div class="rounded-2xl border border-slate-800 bg-[#0f172a] p-4">
                    <p class="text-xs text-slate-400">Poids actuel</p>
                    <p class="text-2xl font-black text-white mt-1">${client.weight} kg</p>
                  </div>
                  <div class="rounded-2xl border border-slate-800 bg-[#0f172a] p-4">
                    <p class="text-xs text-slate-400">Objectif cible</p>
                    <p class="text-2xl font-black text-emerald-400 mt-1">${client.targetWeight} kg</p>
                  </div>
                </div>

                <form onsubmit="logClientWeight(event)" class="rounded-2xl border border-slate-800 bg-[#0f172a] p-4 flex gap-2">
                  <input id="clientWeightInput" type="number" step="0.1" placeholder="Nouvelle pesée (kg)" required class="flex-1 rounded-xl border border-slate-700 bg-slate-950 px-3.5 py-2.5 text-sm text-white" />
                  <button type="submit" class="rounded-xl bg-emerald-500 px-4 py-2.5 text-xs font-bold text-slate-950 hover:bg-emerald-400">
                    Enregistrer
                  </button>
                </form>

                <div class="rounded-2xl border border-slate-800 bg-[#0f172a] p-4">
                  <h3 class="text-sm font-bold text-white mb-3">Historique des pesées</h3>
                  <div class="space-y-2">
                    ${client.weightHistory.slice().reverse().map(entry => `
                      <div class="flex items-center justify-between rounded-xl border border-slate-800 bg-slate-950 px-3.5 py-2 text-sm">
                        <span class="text-slate-400">${entry.date}</span>
                        <span class="font-bold text-white">${entry.val} kg</span>
                      </div>
                    `).join("")}
                  </div>
                </div>
              </div>
            `}
          </main>
        </div>
      `;
    }

    function render() {
      const appEl = document.getElementById("app");
      if (!session) {
        appEl.innerHTML = renderLogin();
      } else if (session.role === "coach") {
        appEl.innerHTML = renderCoach();
      } else {
        appEl.innerHTML = renderClient();
      }
    }

    render();
    initFirestore();
  </script>
</body>
</html>
