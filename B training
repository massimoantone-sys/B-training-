          tips: [
            "Garde les coudes légèrement fléchis et le buste fixe.",
            "Monte les bras jusqu'à l'horizontale sans hausser les trapèzes.",
            "Freine la descente sur 2 secondes."
          ]
        }
      ],
      clients: [
        {
          id: "c1",
          name: "Lucas Moreau",
          code: "LUCAS-2026",
          active: true,
          goal: "Prise de muscle sec",
          weight: 81.5,
          targetWeight: 85,
          weightHistory: [
            { date: "Sem 1", val: 79.8 },
            { date: "Sem 2", val: 80.4 },
            { date: "Sem 3", val: 81.0 },
            { date: "Sem 4", val: 81.5 }
          ],
          nutrition: {
            calories: 2750,
            protein: 175,
            carbs: 320,
            fats: 75,
            meals: "Petit-déj : 100g flocons d'avoine + 30g whey + 1 banane\nDéjeuner : 180g poulet + 250g riz basmati + légumes verts\nCollation : 200g fromage blanc 0% + 25g amandes\nDîner : 180g saumon/colin + 250g patate douce"
          },
          workoutName: "Upper Body — Force & Hypertrophie",
          workoutItems: [
            { uid: "w1", exerciseId: "ex1", sets: 4, reps: "8-10", rest: 90, load: "75 kg", completedSets: [false, false, false, false] },
            { uid: "w2", exerciseId: "ex2", sets: 4, reps: "10-12", rest: 75, load: "60 kg", completedSets: [false, false, false, false] },
            { uid: "w3", exerciseId: "ex4", sets: 3, reps: "12-15", rest: 60, load: "12 kg", completedSets: [false, false, false] }
          ]
        },
        {
          id: "c2",
          name: "Chloé Bernard",
          code: "CHLOE-2026",
          active: true,
          goal: "Perte de masse grasse & Tonification",
          weight: 64.2,
          targetWeight: 59,
          weightHistory: [
            { date: "Sem 1", val: 66.0 },
            { date: "Sem 2", val: 65.3 },
            { date: "Sem 3", val: 64.8 },
            { date: "Sem 4", val: 64.2 }
          ],
          nutrition: {
            calories: 1750,
            protein: 130,
            carbs: 165,
            fats: 55,
            meals: "Petit-déj : 2 œufs brouillés + 2 tranches pain complet\nDéjeuner : 150g blanc de dinde + 150g quinoa + crudités\nDîner : 150g cabillaud + poêlée de courgettes"
          },
          workoutName: "Full Body Tonique",
          workoutItems: [
            { uid: "w4", exerciseId: "ex3", sets: 4, reps: "12", rest: 75, load: "90 kg", completedSets: [false, false, false, false] },
            { uid: "w5", exerciseId: "ex2", sets: 3, reps: "12", rest: 60, load: "35 kg", completedSets: [false, false, false] }
          ]
        }
      ]
    };

    // =========================================================================
    // 3. ÉTAT LOCAL + SYNCHRONISATION FIRESTORE
    // =========================================================================
    let state = JSON.parse(localStorage.getItem("btraining_state_v1")) || structuredClone(DEFAULT_STATE);
    let session = JSON.parse(localStorage.getItem("btraining_session_v1")) || null;
    // session = { role: 'coach' } ou { role: 'client', clientId: 'c1', previewByCoach: false }

    let loginTab = "client";
    let coachTab = "clients"; // 'clients' | 'program' | 'library' | 'security'
    let selectedClientId = state.clients[0]?.id || null;
    let clientTab = "workout"; // 'workout' | 'nutrition' | 'progress'
    let syncStatus = isFirebaseConfigured ? "Connexion Firestore..." : "Mode Local (ajoute ta config Firebase pour la sync)";

    async function saveState() {
      localStorage.setItem("btraining_state_v1", JSON.stringify(state));
      if (db) {
        try {
          syncStatus = "Synchronisation...";
          renderSyncBadge();
          await setDoc(doc(db, ...STATE_DOC_PATH), state);
          syncStatus = "Firestore connecté • Synchronisé";
          renderSyncBadge();
        } catch (err) {
          console.error("Erreur Firestore:", err);
          syncStatus = "Erreur sync Firestore (vérifie les règles)";
          renderSyncBadge();
        }
      }
    }

    function saveSession() {
      if (session) localStorage.setItem("btraining_session_v1", JSON.stringify(session));
      else localStorage.removeItem("btraining_session_v1");
    }

    async function initFirestore() {
      if (!isFirebaseConfigured) return;
      try {
        const app = initializeApp(firebaseConfig);
        db = getFirestore(app);
        const ref = doc(db, ...STATE_DOC_PATH);

        const snap = await getDoc(ref);
        if (!snap.exists()) {
          await setDoc(ref, state);
        } else {
          state = snap.data();
          localStorage.setItem("btraining_state_v1", JSON.stringify(state));
        }

        syncStatus = "Firestore connecté • Temps réel actif";
        render();

        onSnapshot(ref, (docSnap) => {
          if (docSnap.exists()) {
            state = docSnap.data();
            localStorage.setItem("btraining_state_v1", JSON.stringify(state));
            if (!state.clients.find(c => c.id === selectedClientId)) {
              selectedClientId = state.clients[0]?.id || null;
            }
            render();
          }
        });
      } catch (err) {
        console.error(err);
        syncStatus = "Erreur connexion Firebase (config invalide)";
        render();
      }
    }

    function renderSyncBadge() {
      const el = document.getElementById("syncBadge");
      if (el) el.textContent = syncStatus;
    }

    // =========================================================================
    // 4. CHRONOMÈTRE DE REPOS AUTOMATIQUE + BIP AUDIO
    // =========================================================================
    let restTimer = null;
    let restRemaining = 0;
    let restTotal = 90;

    function playBeep() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(880, ctx.currentTime);
        gain.gain.setValueAtTime(0.15, ctx.currentTime);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.35);
      } catch (_) {}
    }

    window.startRestTimer = function(seconds, exerciseName) {
      clearInterval(restTimer);
      restTotal = Math.max(10, Number(seconds) || 60);
      restRemaining = restTotal;

      const bar = document.getElementById("restTimerBar");
      document.getElementById("restExerciseName").textContent = exerciseName || "Récupération";
      bar.classList.remove("hidden");
      updateRestUI();

      restTimer = setInterval(() => {
        restRemaining--;
        if (restRemaining <= 0) {
          clearInterval(restTimer);
          restRemaining = 0;
          updateRestUI();
          playBeep();
          setTimeout(() => {
            bar.classList.add("hidden");
          }, 1800);
        } else {
          updateRestUI();
        }
      }, 1000);
    };

    window.adjustRest = function(delta) {
      restRemaining = Math.max(5, restRemaining + delta);
      if (restRemaining > restTotal) restTotal = restRemaining;
      updateRestUI();
    };

    window.stopRestTimer = function() {
      clearInterval(restTimer);
      document.getElementById("restTimerBar").classList.add("hidden");
    };

    function updateRestUI() {
      const m = String(Math.floor(restRemaining / 60)).padStart(2, "0");
      const s = String(restRemaining % 60).padStart(2, "0");
      document.getElementById("restClock").textContent = `${m}:${s}`;
      const pct = restTotal > 0 ? Math.min(100, Math.round((restRemaining / restTotal) * 100)) : 0;
      document.getElementById("restProgress").style.width = `${pct}%`;
    }

    // =========================================================================
    // 5. MODALE DÉMO VIDÉO / MACHINE
    // =========================================================================
    function extractYoutubeId(url) {
      if (!url) return null;
      const m = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
      return m ? m[1] : null;
    }

    window.openDemoModal = function(exerciseId) {
      const ex = state.exercises.find(e => e.id === exerciseId);
      if (!ex) return;
      document.getElementById("demoTitle").textContent = ex.name;
      document.getElementById("demoMachine").textContent = `Machine / Matériel : ${ex.machine || "Standard"}`;

      const container = document.getElementById("demoVideoContainer");
      const ytId = extractYoutubeId(ex.videoUrl);

      if (ytId) {
        container.innerHTML = `
          <div class="relative aspect-video w-full bg-black">
            <iframe
              class="h-full w-full"
              src="https://www.youtube-nocookie.com/embed/${ytId}?rel=0&playsinline=1"
              title="${ex.name}"
              frameborder="0"
              referrerpolicy="strict-origin-when-cross-origin"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen>
            </iframe>
          </div>
          <div class="flex items-center justify-between bg-slate-900 px-3 py-2 text-xs text-slate-400">
            <span>Problème d'affichage vidéo ?</span>
            <a href="${ex.videoUrl}" target="_blank" rel="noopener noreferrer" class="font-semibold text-emerald-400 hover:underline">Ouvrir sur YouTube ↗</a>
          </div>
        `;
      } else if (ex.videoUrl) {
        container.innerHTML = `
          <div class="p-4 text-center">
            <a href="${ex.videoUrl}" target="_blank" rel="noopener noreferrer" class="inline-block rounded-xl bg-emerald-500/20 border border-emerald-500/40 px-4 py-2 text-sm font-semibold text-emerald-300">
              Ouvrir la vidéo de démonstration ↗
            </a>
          </div>
        `;
      } else {
        container.innerHTML = `<div class="p-4 text-center text-xs text-slate-400">Aucune vidéo renseignée par le coach pour cet exercice.</div>`;
      }

      const tipsEl = document.getElementById("demoTips");
      const tips = Array.isArray(ex.tips) && ex.tips.length ? ex.tips : ["Garde le mouvement contrôlé et la posture stable."];
      tipsEl.innerHTML = tips.map(t => `<li>${t}</li>`).join("");

      const modal = document.getElementById("demoModal");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    };

    window.closeDemoModal = function() {
      const modal = document.getElementById("demoModal");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.getElementById("demoVideoContainer").innerHTML = "";
    };

    // =========================================================================
    // 6. ACTIONS UTILISATEUR (AUTH, COACH, CLIENT)
    // =========================================================================
    window.setLoginTab = function(tab) {
      loginTab = tab;
      render();
    };

    window.fillQuickLogin = function(type) {
      if (type === "coach") {
        loginTab = "coach";
        render();
        document.getElementById("coachEmailInput").value = state.coachAuth.email;
        document.getElementById("coachPassInput").value = state.coachAuth.password;
      } else {
        loginTab = "client";
        render();
        document.getElementById("clientCodeInput").value = type;
      }
    };

    window.handleClientLogin = function(e) {
      e.preventDefault();
      const code = document.getElementById("clientCodeInput").value.trim().toUpperCase();
      const client = state.clients.find(c => c.code.toUpperCase() === code);
      if (!client) {
        alert("Code d'accès invalide. Vérifie auprès de ton coach.");
        return;
      }
      if (!client.active) {
        alert("Ton accès est actuellement suspendu. Contacte ton coach.");
        return;
      }
      session = { role: "client", clientId: client.id, previewByCoach: false };
      saveSession();
      render();
    };

    window.handleCoachLogin = function(e) {
      e.preventDefault();
      const email = document.getElementById("coachEmailInput").value.trim().toLowerCase();
      const pass = document.getElementById("coachPassInput").value;
      if (email === state.coachAuth.email.toLowerCase() && pass === state.coachAuth.password) {
        session = { role: "coach" };
        saveSession();
        render();
      } else {
        alert("Identifiants Coach incorrects.");
      }
    };

    window.logout = function() {
      stopRestTimer();
      session = null;
      saveSession();
      render();
    };

    window.previewClientAsCoach = function(clientId) {
      session = { role: "client", clientId, previewByCoach: true };
      saveSession();
      render();
    };

    window.returnToCoach = function() {
      session = { role: "coach" };
      saveSession();
      render();
    };

    window.setCoachTab = function(tab) {
      coachTab = tab;
      render();
    };

    window.selectClient = function(id) {
      selectedClientId = id;
      render();
    };

    window.createClient = function(e) {
      e.preventDefault();
      const name = document.getElementById("newClientName").value.trim();
      const goal = document.getElementById("newClientGoal").value.trim() || "Remise en forme";
      const weight = parseFloat(document.getElementById("newClientWeight").value) || 75;
      const targetWeight = parseFloat(document.getElementById("newClientTarget").value) || 70;
      if (!name) return;

      const prefix = name.split(" ")[0].toUpperCase().replace(/[^A-Z]/g, "").slice(0, 6) || "ATHLETE";
      const code = `${prefix}-${Math.floor(1000 + Math.random() * 9000)}`;
      const newClient = {
        id: "c_" + Date.now(),
        name,
        code,
        active: true,
        goal,
        weight,
        targetWeight,
        weightHistory: [{ date: "Départ", val: weight }],
        nutrition: { calories: 2200, protein: 150, carbs: 230, fats: 65, meals: "Plan alimentaire à personnaliser." },
        workoutName: "Séance 1 — Programme personnalisé",
        workoutItems: []
      };
      state.clients.push(newClient);
      selectedClientId = newClient.id;
      saveState();
      render();
    };

    window.toggleClientActive = function(clientId) {
      const c = state.clients.find(x => x.id === clientId);
      if (!c) return;
      c.active = !c.active;
      saveState();
      render();
    };

    window.regenerateClientCode = function(clientId) {
      const c = state.clients.find(x => x.id === clientId);
      if (!c) return;
      const prefix = c.name.split(" ")[0].toUpperCase().replace(/[^A-Z]/g, "").slice(0, 6) || "ATHLETE";
      c.code = `${prefix}-${Math.floor(1000 + Math.random() * 9000)}`;
      saveState();
      render();
    };

    window.copyInvite = function(clientId) {
      const c = state.clients.find(x => x.id === clientId);
      if (!c) return;
      const url = window.location.href.split("#")[0];
      const msg = `Salut ${c.name} ! Voici ton accès personnel B training :\nLien : ${url}\nTon code personnel : ${c.code}`;
      navigator.clipboard?.writeText(msg);
      alert("Invitation copiée dans le presse-papier :\n\n" + msg);
    };

    window.addExerciseToClient = function(e) {
      e.preventDefault();
      const c = state.clients.find(x => x.id === selectedClientId);
      if (!c) return;
      const exerciseId = document.getElementById("progExSelect").value;
      const sets = parseInt(document.getElementById("progSets").value) || 4;
      const reps = document.getElementById("progReps").value.trim() || "10";
      const rest = parseInt(document.getElementById("progRest").value) || 90;
      const load = document.getElementById("progLoad").value.trim() || "À définir";

      c.workoutItems.push({
        uid: "w_" + Date.now(),
        exerciseId,
        sets,
        reps,
        rest,
        load,
        completedSets: Array(sets).fill(false)
      });
      saveState();
      render();
    };

    window.removeWorkoutItem = function(uid) {
      const c = state.clients.find(x => x.id === selectedClientId);
      if (!c) return;
      c.workoutItems = c.workoutItems.filter(w => w.uid !== uid);
      saveState();
      render();
    };

    window.saveClientProgramAndNutrition = function() {
      const c = state.clients.find(x => x.id === selectedClientId);
      if (!c) return;
      c.workoutName = document.getElementById("editWorkoutName").value.trim() || c.workoutName;
      c.nutrition.calories = parseInt(document.getElementById("editCal").value) || c.nutrition.calories;
      c.nutrition.protein = parseInt(document.getElementById("editProt").value) || c.nutrition.protein;
      c.nutrition.carbs = parseInt(document.getElementById("editCarbs").value) || c.nutrition.carbs;
      c.nutrition.fats = parseInt(document.getElementById("editFats").value) || c.nutrition.fats;
      c.nutrition.meals = document.getElementById("editMeals").value;
      saveState();
      alert("Programme et nutrition enregistrés et synchronisés !");
      render();
    };

    window.addLibraryExercise = function(e) {
      e.preventDefault();
      const name = document.getElementById("libName").value.trim();
      const muscle = document.getElementById("libMuscle").value.trim() || "Général";
      const machine = document.getElementById("libMachine").value.trim() || "Machine / Haltères";
      const videoUrl = document.getElementById("libVideo").value.trim();
      const tipsRaw = document.getElementById("libTips").value.trim();
      if (!name) return;

      state.exercises.push({
        id: "ex_" + Date.now(),
        name,
        muscle,
        machine,
        videoUrl,
